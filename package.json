{
  "name": "dsh-plugin-stca",
  "version": "0.1.0",
  "description": "STCA for AI agents: learn and save polymer rules from data, screen candidates, and generate and verify polymer repeat units.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json",
    "./icon": "./assets/stca-logo.png",
    "./locale/*.json": "./dsh/locale/*.json"
  },
  "files": [
    "dsh/",
    "skills/stca/",
    "assets/stca-logo.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CITATION.cff",
    "validation/historical_validation_20261107.json",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    "!**/.DS_Store",
    "!**/Thumbs.db",
    "README.DSH.md",
    "README.DSH.zh-CN.md"
  ],
  "icon": "./assets/stca-logo.png",
  "engines": {
    "dsh": ">=0.0.1-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skills",
    "codex-skills",
    "stca",
    "wracc",
    "polymers",
    "polymer-informatics",
    "materials-informatics",
    "cheminformatics",
    "ai-for-science",
    "rule-learning",
    "materials-screening",
    "polymer-design",
    "rdkit"
  ],
  "author": "Weihao Wang",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/foukusa/stca-agent-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foukusa/stca-agent-skill.git"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/foukusa/stca-agent-skill/issues"
  }
}
